# Physical phone on local Wi-Fi: use the development computer's LAN address.
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8000

# Set this to the real ID produced by `eas init`; never invent a project ID.
EXPO_PUBLIC_EAS_PROJECT_ID=

# For a remote phone, `npm run start:tunnel` creates separate Metro and API
# tunnels and injects the API URL for that run.

