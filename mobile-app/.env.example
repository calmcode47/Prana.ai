# Set an address the device can actually reach. For a physical phone on local
# Wi-Fi, use the backend computer's LAN address (for example, port 8000).
# Leave blank to use the emulator/simulator and Expo host auto-detection logic.
EXPO_PUBLIC_API_URL=

# Set this to the real ID produced by `eas init`; never invent a project ID.
EXPO_PUBLIC_EAS_PROJECT_ID=

# For a remote phone, `npm run start:tunnel` proxies the HTTP API through the
# Expo tunnel. WebSocket status remains "Unavailable" unless a deployment URL
# with WebSocket upgrade support is configured in EXPO_PUBLIC_API_URL.

