{
  "expo": {
    "name": "PRANA Air",
    "slug": "prana-air-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "prana",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.prana.air"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EE",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "ai.prana.air",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PRANA Air to select a sky photo for local air-quality analysis.",
          "cameraPermission": "Allow PRANA Air to capture a sky photo for local air-quality analysis."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PRANA Air to use your location for the sky-photo observation coordinates."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EA580C",
          "defaultChannel": "prana-alerts",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-asset"
    ]
  }
}
