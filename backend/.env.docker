# ==============================================================================
# PRANA Containerized Environment Variables
# ==============================================================================

# PostgreSQL with PostGIS extension
DATABASE_URL=postgresql://prana:pranapass@db:5432/prana
POSTGRES_DB=prana
POSTGRES_USER=prana
POSTGRES_PASSWORD=pranapass

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://prana.ai

# NASA FIRMS Map Key (optional - uses high-fidelity cached fixtures if empty)
FIRMS_MAP_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
