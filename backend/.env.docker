# ==============================================================================
# PRANA Containerized Environment Variables
# ==============================================================================

# PostgreSQL with PostGIS extension. Choose a strong value before startup;
# Docker Compose constructs DATABASE_URL inside the backend container.
POSTGRES_DB=prana
POSTGRES_USER=prana
POSTGRES_PASSWORD=

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://prana.ai

# NASA FIRMS Map Key (required for live fire data; missing data remains unavailable)
FIRMS_MAP_KEY=

# Operator and facility-scoped control-plane credentials
PRANA_OPERATOR_API_KEY=
CEMS_INGEST_KEYS_JSON={}

# Never enable demonstration fixtures in a public deployment
PRANA_ENV=production
PRANA_DEMO_MODE=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
