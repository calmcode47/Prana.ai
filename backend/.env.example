# Live data is the default. Enable demonstration fixtures only for explicit demos/tests.
PRANA_ENV=development
PRANA_DEMO_MODE=false
PRANA_SCHEDULER_ENABLED=true
# Persistent PostGIS started by `docker compose up -d db`.
DATABASE_URL=postgresql://prana:pranapass@127.0.0.1:5432/prana
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:8081,http://localhost:19006,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8000,http://127.0.0.1:8081,http://127.0.0.1:19006
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
# Required for CEMS telemetry ingestion. JSON maps each facility ID to its own long key.
CEMS_INGEST_KEYS_JSON={}
# Maximum number of recently reporting corridor locations queried per refresh.
OPENAQ_MAX_LOCATIONS=40
# Open-Meteo weather and CAMS air-quality APIs require no key for noncommercial use.
PRANA_FL_DP_ENABLED=true
PRANA_FL_DP_EPSILON=0.42
PRANA_FL_DP_DELTA=0.00001
PRANA_FL_DP_MAX_GRAD_NORM=1.0
PRANA_FL_PAILLIER_ENABLED=true
HOST=0.0.0.0
PORT=8000
# Optional OpenAI-compatible speech provider. Audio is served by this backend.
TTS_PROVIDER_URL=https://api.openai.com/v1/audio/speech
TTS_PROVIDER_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Required only for the explicit server-side audio generation endpoint. Never
# include this value in Vite or Expo environment variables.
PRANA_OPERATOR_API_KEY=
# Optional signed mobile artifact metadata.
MOBILE_APP_DOWNLOAD_URL=
MOBILE_APP_VERSION=
MOBILE_APP_SHA256=
