# Local mode can use explicitly labelled historical demo datasets.
PRANA_ENV=development
PRANA_DEMO_MODE=true
PRANA_SCHEDULER_ENABLED=true
# Leave empty for ephemeral development storage; set for persistent PostGIS.
DATABASE_URL=
CORS_ORIGINS=http://localhost:8000
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
# Entire service-account JSON, quoted as one dotenv value. Requires an enabled EE project.
GEE_SERVICE_ACCOUNT_JSON=
GEE_PROJECT_ID=
HOST=127.0.0.1
PORT=8000
