# NASA FIRMS API Map Key (Free registration at https://firms.modaps.eosdis.nasa.gov/api/)
FIRMS_MAP_KEY=YOUR_FIRMS_MAP_KEY_HERE

# Google Earth Engine Service Account JSON credentials (optional / for SESSION-002)
GEE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "prana-dev"}

# PostgreSQL + PostGIS connection string
DATABASE_URL=postgresql+asyncpg://prana:prana@localhost:5432/prana

# Allowed CORS origins, comma-separated (never hardcoded)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# OpenAQ API key (optional, public tier works without key)
OPENAQ_API_KEY=
